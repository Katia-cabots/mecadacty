// ============================================================
// Projet Firebase : mecadacty-51f6f
// Référence projet : Mecadacty — site internet
// Version du site : V01-018
// Authentification : Firebase Authentication (Email/Mot de passe)
// ============================================================
// Ces règles vérifient réellement l'identité de la personne
// connectée (request.auth) — contrairement aux anciennes règles
// ouvertes, ici un client ne peut lire/écrire QUE ses propres
// données, et seul un compte "admin" peut tout voir.
// Note : le document "utilisateurs" contient un champ motDePasse
// (copie de confort demandée par Hélène pour le Super Admin,
// risque connu et accepté) — protégé par les mêmes règles de
// lecture (soi-même ou un compte admin), jamais public.
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estConnecte() {
      return request.auth != null;
    }

    function monProfil() {
      return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data;
    }

    function estAdmin() {
      return estConnecte() && monProfil().role == "admin";
    }

    function estProprietaire(clientId) {
      return estConnecte() && request.auth.uid == clientId;
    }

    // Mapping public "identifiant -> email", nécessaire pour retrouver
    // l'e-mail associé à un "User" AVANT la connexion (ne contient aucun
    // mot de passe : Firebase Authentication les gère lui-même, en dehors
    // de Firestore).
    match /identifiantsPublics/{identifiant} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Profils (Super Admin / Admin / Client) — l'ID du document EST l'UID
    // Firebase Authentication de la personne.
    match /utilisateurs/{userId} {
      allow read: if estAdmin() || estProprietaire(userId);
      allow write: if estAdmin();
    }

    match /dossiers/{dossierId} {
      allow read: if estAdmin() || estProprietaire(resource.data.clientId);
      allow create, update, delete: if estAdmin();
    }

    match /rdv/{rdvId} {
      allow read: if estAdmin() || estProprietaire(resource.data.clientId);
      allow create: if estAdmin() || estProprietaire(request.resource.data.clientId);
      allow update, delete: if estAdmin();
    }

    match /messages/{messageId} {
      allow read: if estAdmin() || estProprietaire(resource.data.clientId);
      allow create: if estAdmin() || estProprietaire(request.resource.data.clientId);
      allow update: if estAdmin() || estProprietaire(resource.data.clientId);
      allow delete: if estAdmin();
    }

    match /heures/{heureId} {
      allow read: if estAdmin() || estProprietaire(resource.data.clientId);
      allow write: if estAdmin();
    }

    match /demandesInscription/{demandeId} {
      allow create: if true;
      allow read, update, delete: if estAdmin();
    }

    match /messagesContact/{messageId} {
      allow create: if true;
      allow read, update, delete: if estAdmin();
    }

    match /contenu/{docId} {
      allow read: if true;
      allow write: if estAdmin();
    }

    match /articles/{articleId} {
      allow read: if resource.data.visible == true || estAdmin();
      allow write: if estAdmin();
    }
  }
}
